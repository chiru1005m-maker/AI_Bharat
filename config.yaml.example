# Local Agentic AI System - YAML Configuration
# Alternative to environment variables

llm:
  provider: ollama
  model_name: llama3
  embedding_model: nomic-embed-text
  base_url: http://localhost:11434
  timeout: 30

vector_store:
  persist_directory: ./chroma_db
  collection_name: documents
  chunk_size: 512
  chunk_overlap: 50

retry:
  max_attempts: 3
  min_wait: 2
  max_wait: 10

api:
  host: 0.0.0.0
  port: 8000
  reload: false

log:
  level: INFO
  json_format: false
